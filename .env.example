# ────────────────────────── Network / RPC ──────────────────────────
# Full HTTPS endpoint for a Solana RPC node (Helius, Triton, QuickNode …)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR-API-KEY

# ───────────────────────── Wallet / Keys ───────────────────────────
# Absolute path (or ~/… shortcut) to the JSON keypair created by `solana-keygen new`.
WALLET_PATH=

# ──────────────────────── Pool Configuration ───────────────────────
# Liquidity-bin pool you want to provide to (LB Pair address, **not** LP token).
POOL_ADDRESS=8ztFxjFPfVUtEf4SLSapcFj8GW2dxyUA9no2bLPq7H7V

# How wide the position is (total number of bins across both sides).
TOTAL_BINS_SPAN=60

# Portion of those bins allocated *below* the active price (0–1).
LOWER_COEF=0.50
EDGE_BUFFER_BINS=-1   # integer; negative = preempt, positive = allow outside

# DLMM strategy type. Valid: Spot, Stable, etc.
LIQUIDITY_STRATEGY_TYPE=Spot

# ─────────────────────── Fee & Priority Tuning ─────────────────────
# micro-lamports per CU; 50 000 ≈ “veryHigh” priority on main-net.
PRIORITY_FEE_MICRO_LAMPORTS=50000

# Hard-coded SOL kept in wallet to pay rent/fees (lamports). Default = 0.07 SOL.
SOL_FEE_BUFFER_LAMPORTS=70000000

#Acceptable price impact from Jupiter
PRICE_IMPACT=0.5
SLIPPAGE=50

# Interval between status polls / rebalance checks (sec)
MONITOR_INTERVAL_SECONDS=15

#Whether we manually set bin span parameters
MANUAL=true
MODE=single #portfolio or single
PORTFOLIO_CONFIG=./portfolio.config.json

# Global portfolio defaults (can be overridden per-sleeve in the JSON)
DRIFT_BPS=2500              # 25.00% max allowed drift before rebalancing
MIN_REBALANCE_USD=50       # do nothing below this notional
COOLDOWN_SECONDS=30       # minimum time between portfolio rebalances
PRICE_TTL_SECONDS=60       # price cache TTL for valuation

DITHER_ALPHA_API=https://api.dith.ai/dlmm/metrics
LOOKBACK=30
# If False, the program will open not swap on jupiter before re-opening a pool.
DO_SWAP_ON_OPEN=True
DO_SWAP_ON_CENTER=True
# Where to send the fee share (Base58 pubkey). If unset or invalid, no payout.
FEE_SHARE_WALLET=GNkSCxAU1rVJKwtp3uSatc8o48jMK2eeuSNCnV5hq36L

# Proportion of claimed fees to send (0.0 – 1.0). If <= 0, no payout.
FEE_SHARE_PCT=0.05
# ───────────────────────── Logging / Misc ──────────────────────────
# one of: fatal, error, warn, info, debug, trace
LOG_LEVEL=warn
